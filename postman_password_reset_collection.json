          "body": "{\n    \"status\": false,\n    \"message\": \"Không thể gửi email reset password\",\n    \"data\": {\n        \"error\": \"Email không tồn tại trong hệ thống.\"\n    }\n}"
        }
      ]
    },
    {
      "name": "Error - Mật khẩu yếu",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"{{reset_token}}\",\n    \"password\": \"weak\",\n    \"password_confirmation\": \"weak\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/reset-password",
          "host": ["{{base_url}}"],
          "path": ["api", "reset-password"]
        },
        "description": "Test với mật khẩu không đủ mạnh (< 12 ký tự, thiếu chữ hoa/thường/số/ký tự đặc biệt)."
      },
      "response": [
        {
          "name": "Validation Error",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"abc123\",\n    \"password\": \"weak\",\n    \"password_confirmation\": \"weak\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "reset-password"]
            }
          },
          "status": "Unprocessable Entity",
          "code": 422,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\n    \"message\": \"The password field must be at least 12 characters.\",\n    \"errors\": {\n        \"password\": [\n            \"Mật khẩu phải có ít nhất 12 ký tự\",\n            \"Mật khẩu phải chứa ít nhất 1 chữ hoa, 1 chữ thường, 1 số và 1 ký tự đặc biệt (@$!%*?&#^())\"\n        ]\n    }\n}"
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "reset_token",
      "value": "YOUR_TOKEN_FROM_LOG",
      "type": "string"
    }
  ]
}

