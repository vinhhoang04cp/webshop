{
  "info": {
    "name": "WebShop - Password Reset",
    "description": "Collection để test chức năng đặt lại mật khẩu qua API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345678"
  },
  "item": [
    {
      "name": "1. Forgot Password - Gửi yêu cầu reset",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success status\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "forgot-password"]
        },
        "description": "Gửi yêu cầu reset password. Email sẽ được gửi đến địa chỉ email đã đăng ký."
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "forgot-password"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\n    \"status\": true,\n    \"message\": \"Link đặt lại mật khẩu đã được gửi đến email của bạn. Vui lòng kiểm tra email.\"\n}"
        }
      ]
    },
    {
      "name": "2. Validate Reset Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Token is valid\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data.valid).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"{{reset_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/validate-reset-token",
          "host": ["{{base_url}}"],
          "path": ["api", "validate-reset-token"]
        },
        "description": "Xác thực token reset password trước khi reset. Optional - có thể bỏ qua và reset trực tiếp."
      },
      "response": [
        {
          "name": "Token Valid",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"abc123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/validate-reset-token",
              "host": ["{{base_url}}"],
              "path": ["api", "validate-reset-token"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\n    \"status\": true,\n    \"message\": \"Token hợp lệ\",\n    \"data\": {\n        \"valid\": true\n    }\n}"
        }
      ]
    },
    {
      "name": "3. Reset Password - Đặt lại mật khẩu",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Password reset successful\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(true);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"{{reset_token}}\",\n    \"password\": \"NewPassword@123\",\n    \"password_confirmation\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/reset-password",
          "host": ["{{base_url}}"],
          "path": ["api", "reset-password"]
        },
        "description": "Đặt lại mật khẩu với token hợp lệ.\n\nYêu cầu mật khẩu mới:\n- Tối thiểu 12 ký tự\n- Có chữ HOA\n- Có chữ thường\n- Có số\n- Có ký tự đặc biệt (@$!%*?&#^())"
      },
      "response": [
        {
          "name": "Success Response",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"test@example.com\",\n    \"token\": \"abc123\",\n    \"password\": \"NewPassword@123\",\n    \"password_confirmation\": \"NewPassword@123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/reset-password",
              "host": ["{{base_url}}"],
              "path": ["api", "reset-password"]
            }
          },
          "status": "OK",
          "code": 200,
          "_postman_previewlanguage": "json",
          "header": [],
          "cookie": [],
          "body": "{\n    \"status\": true,\n    \"message\": \"Mật khẩu đã được đặt lại thành công. Bạn có thể đăng nhập với mật khẩu mới.\"\n}"
        }
      ]
    },
    {
      "name": "4. Login - Test mật khẩu mới",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Login successful\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql(true);",
              "    pm.expect(jsonData.token).to.exist;",
              "});",
              "",
              "// Save token for future requests",
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set(\"auth_token\", jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"test@example.com\",\n    \"password\": \"NewPassword@123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/login",
          "host": ["{{base_url}}"],
          "path": ["api", "login"]
        },
        "description": "Test login với mật khẩu mới sau khi reset. Nếu thành công, token sẽ được lưu vào environment."
      },
      "response": []
    },
    {
      "name": "Error - Email không tồn tại",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Accept",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"email\": \"notexist@example.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/forgot-password",
          "host": ["{{base_url}}"],
          "path": ["api", "forgot-password"]
        },
        "description": "Test với email không tồn tại trong hệ thống."
      },
      "response": [
        {
          "name": "Error Response",
          "originalRequest": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"email\": \"notexist@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["api", "forgot-password"]
            }
          },
          "status": "Bad Request",
          "code": 400,
          "_postman_previewlanguage": "json",
          "header": [],
